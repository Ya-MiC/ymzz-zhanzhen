# 晏銘湛箴 — 環境變量範本
# 複製為 .env 並填入實際值；.env 永遠不進版本控制

# AI 注解後端（OpenAI 相容介面）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# 完整性鏈 HMAC 密鑰（服務端）
INTEGRITY_KEY=change-me-to-a-32-byte-random-hex

# 支付模式：mock | vibepay
PAY_MODE=mock

# 應用環境：development | production
APP_ENV=development

# 伺服器綁定埠
SERVER_PORT=8080

# 支付寶 Vibe Pay（官方文檔公開後填寫；拿不到前請勿編造）
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_CERT=
# ALIPAY_GATEWAY_URL=
