{
  "name": "ymzz-dsh-sidebar",
  "version": "0.1.0",
  "description": "晏銘湛箴 DSH 側邊欄插件：一行安裝，重開 DSH 即有側邊欄入口，直達語錄流與 AI 注解。無無即無，zhanranchangji。",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ya-MiC/ymzz-dsh-sidebar"
  },
  "engines": {
    "node": ">=20"
  }
}
